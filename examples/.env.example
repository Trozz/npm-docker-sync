# Copy to .env and fill in real values. Never commit the resulting file.

# NPM admin password. Default is "changeme" until you change it in the NPM UI.
NPM_PASSWORD=changeme

# Cloudflare API token scoped to the zones you want certificates for.
# Needs Zone:DNS:Edit and Zone:Zone:Read permissions.
# Create one at https://dash.cloudflare.com/profile/api-tokens
CF_API_TOKEN=
